# ---------------------------------------------------------------------------
# OpenRadioLink-v0.3 board defaults  (ESP32-S3-WROOM-1-N16R8)
#
# These are *defaults*: sdkconfig is regenerated from this file on a clean
# build.  Anything the user changes in menuconfig lives in sdkconfig and wins.
# ---------------------------------------------------------------------------

# ---- target -----------------------------------------------------------------
CONFIG_IDF_TARGET="esp32s3"

# ---- flash: 16 MB, DIO ------------------------------------------------------
# DIO is mandatory: the OPI (octal) PSRAM shares the SPI0 pins, so the flash
# cannot run in QIO on an -N16R8 module.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# ---- PSRAM: 8 MB octal ------------------------------------------------------
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_BOOT_INIT=y

# ---- console: native USB-Serial/JTAG ---------------------------------------
# This is what keeps "flash with one Type-C cable, no button" working.
# Do NOT switch the console to USB-OTG (TinyUSB) on this board: GPIO19/20 can
# feed either the built-in USB-Serial/JTAG *or* the OTG PHY, not both, and
# giving the pins to OTG breaks keyless reflashing.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=n
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# ---- partitions: 16 MB with OTA --------------------------------------------
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# ---- cpu / RTOS -------------------------------------------------------------
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_TIMER_TASK_STACK_DEPTH=4096

# ---- logging over USB-Serial/JTAG ------------------------------------------
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_COLORS=n

# ---- misc -------------------------------------------------------------------
# Optimisation level is deliberately left at the IDF default (-Og), which keeps
# the bring-up stage debuggable.  Switch to CONFIG_COMPILER_OPTIMIZATION_PERF
# when the audio path lands.
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
# Brownout: the SA818 can pull >1 A on TX and the LM4871 adds peaks, so keep the
# detector but at the lowest level; revisit once the RF stage is measured.
CONFIG_ESP_BROWNOUT_DET=y
CONFIG_ESP_BROWNOUT_DET_LVL_SEL_7=y

# ---- HTTP server: WebSocket ------------------------------------------------
# SDR 模式 uses /ws/sdr to carry both directions of the browser audio.
CONFIG_HTTPD_WS_SUPPORT=y

# ---- lwip: sockets -----------------------------------------------------------
# HTTP :80 + HTTPS :443 (each listen+ctrl+sessions) + NET-P2P's two UDP sockets
# + mDNS: the default 10 is not enough and accept() starts failing with ENFILE.
CONFIG_LWIP_MAX_SOCKETS=24

# ---- mbedtls: HTTPS request records -----------------------------------------
# The panel also accepts raw WAV/MP3 uploads over HTTPS.  Browsers may put the
# request headers and body into a standard 16 KiB TLS application record, so
# the input buffer must retain the full record before httpd can consume it.
# mbedTLS allocations go to PSRAM below; keep the outbound buffer small because
# the panel and audio responses are sent in fragments.
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=16384

# ---- mbedtls: LAN TLS server (https://<ip>/ for the SDR microphone) ----------
# mbedtls allocations go to PSRAM: the RSA/ECDSA sign and the TLS buffers do
# not fit in the internal DRAM the audio path leaves free.
# CONFIG_MBEDTLS_INTERNAL_MEM_ALLOC is not set
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096

# ---- panic diagnostics -------------------------------------------------------
# The board is usually deployed with no serial cable attached, so a crash has to
# leave evidence where the network can read it: a coredump goes to the 64 KB
# "coredump" partition (partitions.csv) and is decoded offline with
#   .idf/tools/python_env/idf5.4_py3.11_env/Scripts/python.exe \
#     .idf/esp-idf/components/espcoredump/espcoredump.py info_corefile \
#     -c <dump.bin> firmware/build/openradiolink.elf
# The reset reason is reported by /api/status ("rst").
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_COREDUMP_CHECKSUM_CRC32=y
CONFIG_ESP_COREDUMP_MAX_TASKS_NUM=64
CONFIG_ESP_COREDUMP_STACK_SIZE=1792

# ---- httpd: request-headers -------------------------------------------------
# The IDF default is 512 bytes, and a modern browser GET (User-Agent + Accept +
# Sec-Fetch-*) overflows it: the server answers "Header fields are too long"
# instead of the panel.
CONFIG_HTTPD_MAX_REQ_HDR_LEN=2048
